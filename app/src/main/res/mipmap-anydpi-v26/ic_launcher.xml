<?xml version="1.0" encoding="utf-8"?>
<!--
    ZKAPriv 3: the Z-Q mark of Zoka Quantic (the same as ZSilent's) on black.
    The mark sits inside the 66 dp safe circle of the 108 dp canvas, so no
    launcher mask crops it. The monochrome layer is for Android 13 themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
