<?xml version="1.0" encoding="utf-8"?>
<!--
    ZKAPriv: the new logo (20/11/2026) on black, as a vector. The mark sits
    inside the 66 dp safe circle of the 108 dp canvas, so no launcher mask
    crops it. The monochrome layer is for Android 13 themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_logo_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_logo_monochrome" />
</adaptive-icon>
